{
  "buildCommand": "cd colegio-de-naujan && npm install && npm run build",
  "outputDirectory": "colegio-de-naujan/dist",
  "installCommand": "cd colegio-de-naujan && npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/chat.js": {
      "runtime": "nodejs20.x"
    }
  }
}
